# PostgreSQL on your server. Keep the real value in .env.local, never in source control.
# Add ?sslmode=require after TLS is enabled on the database endpoint.
DATABASE_URL=postgresql://crm_user:change-me@your-server:5432/deepagents_crm

# Deep Agents accepts any LangChain tool-calling model.
MODEL_NAME=openai:gpt-5.4-mini
OPENAI_API_KEY=replace-me

# 64 hexadecimal characters. Generate with: openssl rand -hex 32
LANGGRAPH_AES_KEY=replace-with-64-hex-characters

# Auth/session settings. Set COOKIE_SECURE=true after adding HTTPS.
SESSION_COOKIE_NAME=crm_session
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
REGISTRATION_ENABLED=true
FIRST_USER_IS_ADMIN=true
# Prevent a LAN visitor from racing to claim the initial administrator account.
FIRST_ADMIN_LOCAL_ONLY=true

APP_HOST=0.0.0.0
APP_PORT=8000
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
# Fail fast with a friendly 503 while the pool reconnects to PostgreSQL.
DB_POOL_TIMEOUT_SECONDS=8
CHECKPOINT_POOL_MAX_SIZE=5
# Add knowledge-agent after PostgreSQL has the pgvector extension installed.
ENABLED_SUBAGENTS=crud-agent,knowledge-agent
AGENT_TIMEOUT_SECONDS=120

# Knowledge-base RAG. The first implementation uses OpenAI embeddings and a
# PostgreSQL pgvector column with 1536 dimensions (text-embedding-3-small).
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_CHUNK_SIZE=1800
KNOWLEDGE_CHUNK_OVERLAP=240

# sync works inside the FastAPI process. async enables Deep Agents' native
# start/check/update/cancel/list lifecycle and requires an Agent Protocol server.
SUBAGENT_EXECUTION=sync
# SUBAGENT_SERVER_URL=http://127.0.0.1:8123
